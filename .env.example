# Copy to .env and fill in (chmod 600). Never commit .env.
# Both services have free tiers; the sweep enforces daily budgets so you stay inside them.

# Adzuna job search API — https://developer.adzuna.com (free: 250 calls/day, 1,000/week)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# SerpApi Google for Jobs — https://serpapi.com (free: 250 searches/month)
# This is the only route to Indeed / LinkedIn postings; neither site is ever scraped directly.
SERPAPI_KEY=
